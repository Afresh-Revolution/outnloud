# Gatewav backend. The public production API is the default in code.
GATEWAV_API_URL=https://ticketing-back.onrender.com

# Optional. Paste the event UUID from the Gatewav admin.
# If this is empty, the site uses the event whose title contains "Out N Loud".
GATEWAV_EVENT_ID=

# Optional. Public URL Paystack should return buyers to.
# Leave empty in local development so the current host is used.
NEXT_PUBLIC_SITE_URL=

# Supabase session pooler, port 5432. Dashboard ? Connect ? Session pooler.
# postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Cloudinary ? API Keys. Images and short videos from the admin gallery, lineup, and partner logos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend. Used when the admin emails the community list about tickets or the lineup.
RESEND_API_KEY=
RESEND_FROM="Out N Loud <info@yourdomain.com>"

# Sign-in for /admin. ADMIN_SESSION_SECRET can be any long random string.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
